# Google Apps Script web app that receives applications (see google/SETUP.md).
APPS_SCRIPT_URL=
# Must match the SECRET constant at the top of google/apps-script.gs.
APPS_SCRIPT_SECRET=
# Meta Pixel id (browser). Leave empty to disable the pixel.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token (server only). Leave empty to disable CAPI.
META_CAPI_ACCESS_TOKEN=
# Test Events code from Events Manager. Remove in production.
META_TEST_EVENT_CODE=
# "true" logs form payloads (browser + server) for testing. Leave empty in production.
NEXT_PUBLIC_DEBUG_FORM=
